#include <stdio.h>
#include <stdlib.h>

int compara(int a, int b){
	if(a>b)return a;
	else return b;
}
int main(){
	int valores[10];
	int maior, menor, i;
	printf("Leia os numeros\n");

for(i=0; i<10; i++){
	scanf("%d", &valores[i]);	
}
for (i=1, maior= valores[0]; i<5; i=i+2){
int comp_temp = compara(valores[i],valores[i+1]);
maior = compara(maior, comp_temp);
}
for(i=9; i>=0; i--){
		printf("|%d|",valores[i]);		
}
printf("\n %d", maior);
