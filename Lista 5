// exercício 5 //
#include <stdio.h>
#include <stdlib.h>
int main() {

    int vetor[100];
    int i, j;
    int primo;

    for (i = 0; i < 100; i++) {
        vetor[i] = i + 1;
    }
    for (i = 0; i < 100; i++) {
        if (vetor[i] % 2 == 0) {
            printf("%d PAR", vetor[i]);
        } else {
            printf("%d IMPAR", vetor[i]);
        }
        primo = 1;
        if (vetor[i] < 2) {
            primo = 0;
        } else {
            for (j = 2; j < vetor[i]; j++) {
                if (vetor[i] % j == 0) {
                    primo = 0;
                    break;
                }
            }
        }
        if (primo == 1) {
            printf(" e PRIMO \n");
        } else {
            printf(" e NAO PRIMO \n");
        }
    }
    return 0;
}

// exercício 7 //
#include <stdio.h>
#include <stdlib.h>

int main() {

    int vetor[100];
    int i;
    int consecutivo = 0;

    for (i = 0; i < 100; i++) {
        printf("Digite o numero da posicao %d: ", i + 1);
        scanf("%d", &vetor[i]);
    }

    printf("\n Numeros em ordem consecutiva:\n");
    for (i = 0; i < 99; i++) {

        if (vetor[i + 1] == vetor[i] + 1) {

            printf("%d e %d\n", vetor[i], vetor[i + 1]);

           consecutivo = 1;
        }
    }
    if (consecutivo == 0) {
        printf("Nenhum numero consecutivo encontrado.\n");
    }
    return 0;
}
